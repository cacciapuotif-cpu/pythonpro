# PythonPro environment template
# Copy to .env and fill real values locally. Never commit .env or .env.* files.
# Empty values below are intentional placeholders, not defaults for production.

# Project / ports
COMPOSE_PROJECT_NAME=pythonpro
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
BACKEND_PORT=8001
FRONTEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
WORKERS=2
TIMEOUT=60
GRACEFUL_TIMEOUT=20

# Database
DB_NAME=gestionale
DB_USER=
DB_PASSWORD=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_APP_USER=
DB_APP_PASSWORD=

# Redis
REDIS_PASSWORD=

# Security / bootstrap
JWT_SECRET_KEY=
ADMIN_DEFAULT_PASSWORD=
OPERATOR_DEFAULT_PASSWORD=
CORS_ALLOWED_ORIGINS=

# Backup
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_COUNT=30
BACKUP_DAILY_TIME=02:00
BACKUP_WEEKLY_TIME=03:00
BACKUP_MONTHLY_INTERVAL_DAYS=30

# Security audit log (pulizia solo dopo approvazione umana)
AUDIT_LOG_RETENTION_MONTHS=24

# AI / LLM
AI_AGENT_LLM_PROVIDER=none
AI_AGENT_LLM_MODEL=
AI_AGENT_LLM_TIMEOUT_SECONDS=25
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENCLAW_BASE_URL=http://host.docker.internal:18789
OPENCLAW_API_KEY=
OPENCLAW_CHAT_PATH=/v1/chat/completions

# Email / IMAP
ENABLE_EMAIL=false
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
INBOX_POLL_INTERVAL_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gestionale.local
SMTP_TEST_MODE=false
SMTP_USE_TLS=true
PASSWORD_RESET_URL_BASE=http://localhost:3001/reset-password

# WhatsApp / Meta
ENABLE_WHATSAPP=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
WHATSAPP_TIMEOUT_SECONDS=15
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v17.0
WHATSAPP_META_BASE_URL=https://graph.facebook.com
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

# Frontend build
REACT_APP_API_URL=
